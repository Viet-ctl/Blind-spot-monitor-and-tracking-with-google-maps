// --- THÔNG TIN WI-FI ---
char ssid[] = "...";
char pass[] = "22122222";

// --- CẤU HÌNH PHẦN CỨNG ---
#define SCREEN_WIDTH 128 
#define SCREEN_HEIGHT 64 
#define OLED_RESET    -1 
Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, OLED_RESET);

#define r 25  
#define g 26  

#define sensorPin 36 
#define TOUCH_PIN 4  
#define BUZZER_PIN 32 

//NGƯỠNG KHOẢNG CÁCH
#define RED_MIN   2
#define RED_MAX   100   
#define GREEN_MIN 101
#define GREEN_MAX 200   

float HESO = 17.85; 

//BIẾN TOÀN CỤC
int distance; 
int currentMode = 0; 

bool lastTouchState = LOW;
unsigned long lastDebounceTime = 0;

unsigned long previousLedMillis = 0;
int fadeValue = 0;
bool fadeDirection = true; 
int currentLedState = -1; 

unsigned long previousDisplayMillis = 0;
unsigned long previousBuzzerMillis = 0;
bool buzzerState = false;

float avgADC_Debug = 0;

WiFiUDP ntpUDP;
NTPClient timeClient(ntpUDP, "pool.ntp.org", 25200, 60000); 

//BIẾN TOÀN CỤC CHO CHRONOS
ChronosESP32 watch("Smart Dash"); // Tên Bluetooth của mạch
Navigation currentNavData;
bool isNavigationActive = false; 
uint32_t nav_crc = 0xFFFFFFFF;

//BLYNK CALLBACKS
BLYNK_WRITE(V0) { currentMode = param.asInt(); }

// ==========================================
// CALLBACK CỦA CHRONOS (Xử lý dữ liệu BLE)
// ==========================================
void configCallback(Config config, uint32_t a, uint32_t b) {
    switch (config) {
        case CF_NAV_DATA:
            isNavigationActive = a; 
            if (isNavigationActive) {
                currentNavData = watch.getNavigation(); 
            }
            break;
        case CF_NAV_ICON:
            if (a == 2){ 
                Navigation tempNav = watch.getNavigation(); 
                if (nav_crc != tempNav.iconCRC) {
                    nav_crc = tempNav.iconCRC;
                    currentNavData = tempNav; 
                }
            }
            break;
    }
}

// SETUP
void setup() {
  Serial.begin(115200); 
  
  analogReadResolution(12);      
  analogSetAttenuation(ADC_11db); 
  
  if(!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) { 
    Serial.println(F("Loi: Khong tim thay OLED"));
    for(;;); 
  }
  
  pinMode(r, OUTPUT); 
  pinMode(g, OUTPUT); 
  pinMode(BUZZER_PIN, OUTPUT); 
  pinMode(TOUCH_PIN, INPUT);
  
  turnOffLed(); 
  digitalWrite(BUZZER_PIN, LOW); 
  
  display.clearDisplay(); display.setTextColor(SSD1306_WHITE); display.setTextSize(1);
  display.setCursor(10, 25); display.print("Connecting WiFi..."); display.display();
  
  Blynk.begin(BLYNK_AUTH_TOKEN, ssid, pass);
  timeClient.begin();

  // Khởi tạo Chronos BLE
  watch.setConfigurationCallback(configCallback);
  watch.begin(); 
}

void loop() {
  Blynk.run();         
  timeClient.update(); 
  watch.loop();        // Duy trì kết nối Bluetooth Chronos
  calDistance();       
  handleTouch();       
  handleBuzzer(); 
  handleLEDs();        
  if (millis() - previousDisplayMillis >= 100) {
    previousDisplayMillis = millis();
    updateScreenMode();
  }
}
void handleBuzzer() {
  unsigned long currentMillis = millis();
  int interval = 0; 

  if (distance <= 15) {
    interval = 100; 
  } else if (distance <= 30) {
    interval = 350; 
  }

  if (interval > 0) {
    if (currentMillis - previousBuzzerMillis >= interval) {
      previousBuzzerMillis = currentMillis;
      buzzerState = !buzzerState; 
      digitalWrite(BUZZER_PIN, buzzerState ? HIGH : LOW);
    }
  } else {
    digitalWrite(BUZZER_PIN, LOW);
    buzzerState = false;
  }
}

void calDistance() {
  const int NUM_SAMPLES = 25;
  int readings[NUM_SAMPLES];
  
  for(int i = 0; i < NUM_SAMPLES; i++) {
    readings[i] = analogRead(sensorPin);
    delayMicroseconds(400); 
  }
  
  for(int i = 0; i < NUM_SAMPLES - 1; i++) {
    for(int j = i + 1; j < NUM_SAMPLES; j++) {
      if(readings[i] > readings[j]) {
        int temp = readings[i];
        readings[i] = readings[j];
        readings[j] = temp;
      }
    }
  }
  
  long filteredSum = 0;
  for(int i = 5; i < NUM_SAMPLES - 5; i++) {
    filteredSum += readings[i];
  }
  float avgADC = (float)filteredSum / 15.0;
  avgADC_Debug = avgADC; 
  
  distance = (int)((avgADC / HESO) + 0.5); 
  
  if (distance > 200) {
    distance = 201; 
  } else if (distance < 2) {
    distance = 2;   
  }
}


void handleTouch() {
  bool currentTouch = digitalRead(TOUCH_PIN);
  if (currentTouch == HIGH && lastTouchState == LOW && (millis() - lastDebounceTime > 200)) {
    lastDebounceTime = millis(); currentMode++; 
    if (currentMode > 2) currentMode = 0; 
    Blynk.virtualWrite(V0, currentMode); 
  }
  lastTouchState = currentTouch; 
}

void updateScreenMode() {
  display.clearDisplay(); display.setTextColor(SSD1306_WHITE);
  
  // --- MODE 0: CẢNH BÁO ĐIỂM MÙ ---
  if (currentMode == 0) {
    display.setTextSize(1); display.setCursor(15, 0); display.print("HE THONG GIAM SAT");
    display.setTextSize(3); display.setCursor(10, 22); 
    
    if (distance > 200) { display.setCursor(30, 22); display.print("SAFE"); } 
    else { float dist_m = distance / 100.0; display.print(dist_m, 2); display.print("m"); }
    
    display.setTextSize(1); display.setCursor(0, 55);
    if (distance <= 15) display.print("!!! VA CHAM !!!");
    else if (distance <= 30) display.print(" CANH BAO GAN");
    else if (distance <= RED_MAX) display.print("NGUY HIEM");
    else if (distance <= GREEN_MAX) display.print("CANH BAO");
    else display.print("AN TOAN");
    
  //MODE 1: DẪN ĐƯỜNG (CHRONOS)
  } else if (currentMode == 1) {
    if (!isNavigationActive) {
        display.setTextSize(1);
        display.setCursor(20, 28);
        display.print("Waiting for Nav...");
    } else {
        // Vẽ icon bản đồ 48x48 pixel từ điện thoại truyền sang
        if (nav_crc != 0xFFFFFFFF) { 
            display.drawBitmap(0, 10, currentNavData.icon, 48, 48, SSD1306_WHITE);
        } else {
            display.fillRect(0, 10, 48, 48, SSD1306_BLACK);
        }

        // Cột hiển thị chữ sẽ nằm bên phải icon (từ pixel thứ 52)
        int textX = 52;
        
        display.setTextSize(1);
        display.setCursor(textX, 12);
        display.print("Dist:");
        display.setCursor(textX, 22);
        display.print(currentNavData.distance); // Khoảng cách đến ngã rẽ

        display.setCursor(textX, 40);
        display.print("To:");
        display.setCursor(textX, 50);
        display.print(currentNavData.title); // Hướng rẽ tiếp theo
    }
    
  // MODE 2: ĐỒNG HỒ NTP
  } else if (currentMode == 2) {
    display.setTextSize(1); display.setCursor(20, 0); display.print("DONG HO HE THONG");
    String hours = String(timeClient.getHours()); if(hours.length() < 2) hours = "0" + hours;
    String minutes = String(timeClient.getMinutes()); if(minutes.length() < 2) minutes = "0" + minutes;
    String seconds = String(timeClient.getSeconds()); if(seconds.length() < 2) seconds = "0" + seconds;
    display.setTextSize(3); display.setCursor(15, 22); display.print(hours + ":" + minutes);
    display.setTextSize(1); display.setCursor(105, 36); display.print(seconds);
  }
  
  display.display();
}

void handleLEDs() {
  unsigned long currentMillis = millis(); 
  if (distance <= 30) {
    analogWrite(r, buzzerState ? 255 : 0); analogWrite(g, 0); currentLedState = -1; 
  } else if (distance <= RED_MAX) {
    if (currentLedState != 0) { turnOffLed(); fadeValue = 0; fadeDirection = true; currentLedState = 0; }
    if (currentMillis - previousLedMillis >= 3) { previousLedMillis = currentMillis; updateFade(10); analogWrite(r, fadeValue); analogWrite(g, 0); }
  } else if (distance <= GREEN_MAX) {
    if (currentLedState != 1) { turnOffLed(); fadeValue = 0; fadeDirection = true; currentLedState = 1; }
    if (currentMillis - previousLedMillis >= 5) { previousLedMillis = currentMillis; updateFade(5); analogWrite(r, 0); analogWrite(g, fadeValue); }
  } else { 
    turnOffLed(); currentLedState = -1;
  }
}

void updateFade(int step) {
  if (fadeDirection) { fadeValue += step; if (fadeValue >= 255) { fadeValue = 255; fadeDirection = false; } } 
  else { fadeValue -= step; if (fadeValue <= 0) { fadeValue = 0; fadeDirection = true; } }
}

void turnOffLed() { analogWrite(r, 0); analogWrite(g, 0); }
